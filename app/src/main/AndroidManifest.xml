<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location is optional and off by default. Two permissions because there are two
         separate modes, and the app asks for exactly the one the chosen mode needs:

         COARSE  -> "Network": cell towers and Wi-Fi only, accurate to a neighbourhood,
                    which is all a weather grid cell needs. The GNSS receiver is never started.
         FINE    -> "GPS": only requested if the user picks that mode explicitly.

         Neither is required to run the wallpaper, and "Custom" needs no location permission at
         all. See location/DeviceLocationKind.kt. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- The complete list of hosts this app contacts, and the only thing that starts each one.
         Kept as an inventory rather than a summary because it is a privacy disclosure, and a
         summary is how the city-geocoding endpoint went unlisted for several releases.
         InternetInventoryTest fails if a host written in the source is missing from this list, so
         a new host cannot go unlisted without a test going red, and if a host listed here is no
         longer contacted (v5.9B); it does not check anything said below about when calls are made.

         api.github.com               update.UpdateChecker, to read the public Releases list. No
                                      credentials, and nothing about the device is sent: it is a
                                      plain GET of a public page. THREE callers.
                                      1. the "Check for updates" button in Advanced and about,
                                         which always works;
                                      2. while "Check for updates when I open PaperScrape" is
                                         on (off by default), once each time the settings screen is
                                         opened and once when that switch is turned on; and,
                                         whatever that switch says, when it is opened by tapping
                                         an update notification;
                                      3. only while BOTH that switch and "Notify me about new
                                         versions" are on, about once every 3 hours from a job
                                         of the phone's own scheduler (update.UpdateCheckJobService,
                                         since v5.15; from the wallpaper engine's loop, and only
                                         while the wallpaper was on screen, v5.7D to v5.14): with
                                         the screen off and whatever the wallpaper, only with a
                                         network and while the phone would show its notification
                                         (PaperScrape's notifications and their channel on in the
                                         phone's settings, the permission on Android 13+), and
                                         when the phone allows it inside the period
                                         - with the screen off for long, or for an app it judges
                                         rarely used, it waits longer. A check that finds nothing
                                         out is tried again sooner (2, 4, 8 minutes and so on,
                                         doubling); one GitHub turns away because the network has
                                         spent its requests is not tried again before the moment
                                         GitHub gives, and then once. The job is scheduled when
                                         both switches come on, and put back when the wallpaper
                                         or the settings start after a force stop took it away;
                                         its periodic runs start a period later. One check at
                                         once with it: the job's own when "Notify me about new
                                         versions" comes on or the wallpaper puts it back, the
                                         settings screen's (caller 2) when the other switch
                                         comes on or the screen opens - never both for one event. Since
                                         v5.10D every caller sends the ETag of its last answer
                                         (If-None-Match), and while the list has not changed
                                         GitHub answers 304 with no body; since v5.15 caller 3,
                                         and caller 2 unless a tapped notification opened it, make no
                                         request inside a limit GitHub has set (the button and a
                                         tapped notification ask anyway). One request at a time:
                                         a check that finds another one on the network takes its
                                         answer, and callers 2 (not from a notification) and 3 take an answer
                                         GitHub gave less than a minute before, to any caller.
                                         Both switches off, which is the default, and only
                                         caller 1 remains (and caller 2 for an update
                                         notification posted before they were turned off).
                                      With every switch off this host is contacted only when the
                                      user asks: the button, or a tap on such a notification.
         github.com                   update.ApkDownloader, only after the user taps "Install
                                      update" in the update dialog or "Download and install" in
                                      Advanced and about: the release's APK and its SHA-256 file,
                                      at the github.com addresses the Releases list gives. The
                                      release page and the project page are github.com addresses
                                      too, but those are handed to the phone's browser, which is
                                      what opens them.
         www.github.com               the same download, if the Releases list ever gave this
                                      spelling: sanitizeGitHubUrl accepts exactly these two hosts
                                      and refuses every other. GitHub answers with a redirect,
                                      and the download FOLLOWS it - the redirect's host is not
                                      checked:
         release-assets.githubusercontent.com
                                      where the bytes of both files actually come from: the host
                                      GitHub's redirect named on 2026-09-25, for the v5.7 APK
                                      and for its SHA-256 file. GitHub chooses it and may
                                      change it. The file is what is checked, not the host: its
                                      SHA-256 and its signing certificate are verified before
                                      Android's installer is ever handed it.
         api.open-meteo.com           weather.OpenMeteoProvider, the default provider, about once
                                      an hour and only while Live Weather is on, and again as
                                      soon as the location, the provider or a key changes. Each
                                      wallpaper engine keeps its own timer, so a new one - or the
                                      system picker's preview, which is a second engine - fetches
                                      at once, and a request that failed on the network is
                                      retried sooner (2, 4, 8, 16, 32 minutes, then hourly).
         customer-api.open-meteo.com  the same provider, used instead when the user has entered a
                                      key. Same schedule.
         api.openweathermap.org       weather.OpenWeatherProvider, same schedule, only if the user
                                      selected this provider.
         api.weatherapi.com           weather.WeatherApiComProvider, same schedule, only if the
                                      user selected this provider.
         geocoding-api.open-meteo.com location.CityGeocoder, only while the user types a city name
                                      into Custom location: 500 ms after typing pauses (two
                                      characters or more), or at once from the keyboard's search
                                      key. Sends the typed text and nothing else, and never on a
                                      recurring timer.

         Weather and city search send a coarse latitude/longitude or a typed place name; the
         place-name row also passes the saved position to the platform's own geocoder, which on
         most devices looks it up over the network, rounded to two decimals like the weather
         requests (v5.8C; it went unrounded before). No device identifier, no
         account, no analytics. The wallpaper engine makes one kind of call, on its own visible
         loop: the hourly weather fetch. The update check of caller 3 above is the one call made
         with nothing on screen, by the phone's job scheduler (since v5.15). With Live Weather off
         and both update switches off, the app makes no
         network call of its own except when the user asks for one: the update button, an update
         download, a city search. The place-name row's platform lookup can still happen whenever
         the settings screen shows a position. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Used only by Advanced & about -> Updates, and only after the user taps "Install update"
         in the update dialog or "Download and install" there: the downloaded APK is handed to
         Android's own installer, which shows its own confirmation. Nothing is installed silently,
         and the app never installs anything but an APK it has just downloaded from its own GitHub
         release and verified against that release's SHA-256. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Declared for the one notification this app posts: "a newer release is available", from
         the update job's check every three hours (update.UpdateCheckJobService), and only while the
         user has switched both "Check for updates when I open PaperScrape" and "Notify me about new
         versions" on.

         From Android 13 (API 33) this is a runtime permission and is asked for the first time the
         second switch is turned on, never at startup: an app that asks on first launch is asking
         before the user has any idea what it would say. Below API 33 the platform grants it at
         install time and there is nothing to ask; update.UpdateNotificationPolicy is where that
         boundary lives, and it is asserted from the JVM at 26, 29, 32, 33, 34 and 37 because the
         project's only test device is API 29 and cannot reach the other branch at all.

         The channel is IMPORTANCE_DEFAULT with its sound and vibration taken off (since v5.15;
         IMPORTANCE_LOW until then): a small house icon in the status bar, the notification among
         the normal ones in the shade and whole on the lock screen, and no sound, no vibration and no
         pop-up banner. See update.UpdateNotifier. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declared for the update job alone (update.UpdateCheckJobService, v5.15): a job of the phone's
         scheduler kept across a restart of the phone ("persisted") needs it, and the app has no
         receiver of its own for it - the scheduler restores the job. The job exists only while both
         update switches are on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />

    <!-- usesCleartextTraffic="false" below is belt over the braces, and is labelled as such
         rather than sold as a fix. The app never builds an http:// URL: every host in the
         inventory above is https, and sanitizeGitHubUrl refuses any other scheme by construction,
         so the only route to cleartext is an https-to-http redirect, and injecting one needs TLS
         already broken.

         It is here because minSdk is 26 and the platform default is only "refuse" from Android 9
         onwards: on 8.0 and 8.1, which this app still supports, the platform default is "allow".
         The attribute is honoured from API 23, so it covers exactly the two versions the framework
         default does not. One line, no measurable risk removed, and it is now a declaration rather
         than an inherited default that changes underneath the app. (v5.3B audit, S3.)

         enableOnBackInvokedCallback is read from API 33 and dataExtractionRules from API 31, and
         both are ignored below, which is what lint's UnusedAttribute says and why it is ignored on
         this element: below those levels nothing needs them.

         allowBackup="false", fullBackupContent and dataExtractionRules say one thing: nothing of
         the app's leaves the phone through Android, not to the cloud and not to a new phone. The
         first two govern up to Android 11; from 12 the rules file does, because allowBackup alone
         does not stop the transfer to a new phone on some manufacturers' devices
         (res/xml/data_extraction_rules.xml has the reason and the decision).

         Note for the next editor: an XML comment may not contain a double hyphen, which is why
         this file's comments use colons and full stops where the Kotlin ones use dashes. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PaperScrape"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="UnusedAttribute">

        <!-- Settings / preview activity, shown from the system wallpaper picker and from whichever
             of the launcher aliases below is enabled.

             It has no MAIN/LAUNCHER filter of its own any more, and must not get one back: it
             would be a second, permanent entry in the app drawer beside the seasonal one. It is
             still exported, because the wallpaper picker starts it by the component name written
             in res/xml/wallpaper.xml. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.PaperScrape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|layoutDirection|locale|keyboardHidden" />

        <!-- The launcher entry, in six flavours, of which exactly one is enabled at rest (two for
             the instant between enabling the new one and disabling the old).
             icon.SeasonalIcon says which, icon.LauncherIconSwitch does the enabling, and
             SeasonalIconManifestTest checks that this block and that enum still agree.

             They are aliases and not six icons on one activity because an app cannot change the
             icon it declares; it can only choose which of its launcher entries the system draws.
             The switch is made from inside the app with DONT_KILL_APP: that flag is what keeps the
             live wallpaper alive across the change, and nothing outside the app can pass it.

             android:name on each of these is a stable identifier. A home-screen shortcut points at
             the alias by name, so renaming one strands every user who had the app on their home
             screen; treat these six strings as shipped API. -->

        <!-- No season: the shipped town. This is the one the manifest enables, so it is what a
             fresh install draws until the app first runs, and it is where a calendar with a gap
             in it lands. It reuses the icon this app already had rather than being a sixth
             drawing; enabling any of the five instead would be a guess that is wrong four times
             out of five. -->
        <activity-alias
            android:name=".ui.IconDefault"
            android:targetActivity=".ui.SettingsActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Winter: CalendarWindow.WINTER, and any occasion landing inside it that has no icon. -->
        <activity-alias
            android:name=".ui.IconWinter"
            android:targetActivity=".ui.SettingsActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_winter"
            android:roundIcon="@mipmap/ic_launcher_winter"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Spring: CalendarWindow.SPRING, and any occasion landing inside it that has no icon. -->
        <activity-alias
            android:name=".ui.IconSpring"
            android:targetActivity=".ui.SettingsActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_spring"
            android:roundIcon="@mipmap/ic_launcher_spring"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Summer: CalendarWindow.SUMMER, and any occasion landing inside it that has no icon. -->
        <activity-alias
            android:name=".ui.IconSummer"
            android:targetActivity=".ui.SettingsActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_summer"
            android:roundIcon="@mipmap/ic_launcher_summer"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Autumn: CalendarWindow.AUTUMN, and any occasion landing inside it that has no icon. -->
        <activity-alias
            android:name=".ui.IconAutumn"
            android:targetActivity=".ui.SettingsActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_autumn"
            android:roundIcon="@mipmap/ic_launcher_autumn"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Christmas: CalendarWindow.CHRISTMAS, the one occasion with an icon of its own. It is
             the evening scene, which is why it has a moon and not a sun: drawn from the day
             palette it sat 9 of 255 away from Winter and was invisible on a home screen. -->
        <activity-alias
            android:name=".ui.IconChristmas"
            android:targetActivity=".ui.SettingsActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_christmas"
            android:roundIcon="@mipmap/ic_launcher_christmas"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Shares the downloaded APK with the system installer. The file sits in this app's own
             cache directory, which no other process can read by path, so a content URI with a
             read grant is the only way to pass it on (file:// URIs have been banned since API 24). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- The update check every three hours, run by the phone's job scheduler with the screen off
             and whatever the wallpaper (v5.15). Bound only by the scheduler: BIND_JOB_SERVICE is the
             system's own permission, and it is not exported. -->
        <service
            android:name=".update.UpdateCheckJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".engine.PaperWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

    </application>

</manifest>

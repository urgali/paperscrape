<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional: only used if the user enables "sync sunrise/sunset with my location" -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Only used by the in-app update checker (ui.SettingsActivity), once per app launch, to
         fetch the latest release tag from the public GitHub Releases API, and by Live Weather
         (engine.PaperWallpaperService + weather.WeatherRepository), at most once an hour and only
         when the user has turned Live Weather on, to fetch current conditions from Open-Meteo. No
         other network calls exist anywhere in the app or the live wallpaper engine itself. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PaperScrape"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <!-- Settings / preview activity shown from the app launcher and from the system wallpaper picker -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.PaperScrape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".engine.PaperWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

    </application>

</manifest>

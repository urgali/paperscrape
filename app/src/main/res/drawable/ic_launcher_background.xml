<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the sky, the ringed sun, the hill, the ground and the road of the
     town the user sees when the wallpaper opens. The colours are the scene's own
     (SceneTheme.SUNSET.skyDay for the sky ramp, Paper Orange for the ground, road surface day
     for the asphalt), not tints invented for the icon.

     Containment: the only drawing that has to stay inside the safe zone is the sun, at 29.79 dp
     from the centre against a safe radius of 33 dp, so 3.21 dp of margin. Sky, hill, ground,
     asphalt and centre line reach the edge on purpose: they are background that bleeds under
     any launcher mask, and clipping them is the intended behaviour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sky: the SceneTheme.SUNSET.skyDay ramp (#6EC6FF -> #CDEFFF). It stops at y=66, as -->
    <!-- it does in the scene, so the gradient is not squashed under the ground. -->
    <path
        android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="66">
                <item android:offset="0" android:color="#FF6EC6FF" />
                <item android:offset="1" android:color="#FFCDEFFF" />
            </gradient>
        </aapt:attr>
    </path>
